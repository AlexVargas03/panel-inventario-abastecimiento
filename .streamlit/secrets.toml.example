# Copia este archivo como .streamlit/secrets.toml (en local) o pega su contenido
# en Streamlit Cloud → tu app → Settings → Secrets. NUNCA subas secrets.toml a GitHub.

ANTHROPIC_API_KEY = "sk-ant-..."
# Opcional: modelo de Claude (por defecto claude-sonnet-4-5)
# ANTHROPIC_MODEL = "claude-sonnet-4-5"
# Opcional: contraseña para entrar a la app
# APP_PASSWORD = "cambia-esto"
